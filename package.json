{
  "name": "ncm-analyze-tree",
  "version": "4.0.0",
  "license": "MIT",
  "repository": "nodesource/ncm-analyze-tree",
  "description": "Get certification data for a module's dependency tree",
  "scripts": {
    "test": "standard && npm run test:deps && node example.js",
    "test:deps": "dependency-check . --missing && dependency-check . --unused --no-dev"
  },
  "devDependencies": {
    "dependency-check": "^4.1.0",
    "standard": "^17.1.2"
  },
  "dependencies": {
    "graphql-request": "^3.7.0",
    "semver": "^5.7.2",
    "universal-module-tree": "^2.2.0"
  }
}
